  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cook spaghetti, drain, and set aside."
    },
    {
      "@type": "HowToStep",
      "text": "Brown bacon in a frying pan with garlic salt or minced garlic."
    },
    {
      "@type": "HowToStep",
      "text": "Remove bacon and most of the grease from the pan."
    },
    {
      "@type": "HowToStep",
      "text": "Cook onion and mushrooms in the same pan until tender."
    },
    {
      "@type": "HowToStep",
      "text": "Return bacon to the pan and add mushroom soup."
    },
    {
      "@type": "HowToStep",
      "text": "Stir and heat the sauce through, adding cheese and enough water to achieve the desired consistency."
    },
    {
      "@type": "HowToStep",
      "text": "Combine the sauce with cooked spaghetti and serve."
    }
  ],
