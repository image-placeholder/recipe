  "name": "Chicken Breast",
  "author": {
    "@type": "Person",
    "name": "Sandra Martin"
  },
  "description": "A simple breaded chicken breast recipe.",
  "recipeCategory": "Main Course",
  "recipeCuisine": "American",
  "prepTime": "PT15M",
  "cookTime": "PT30M",
  "totalTime": "PT45M",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "6 chicken breasts",
    "1 cup bread crumbs",
    "1 tsp garlic powder",
    "1 egg",
    "1/2 cup milk",
    "Salt and seasoning to taste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Wash chicken breast."
    },
    {
      "@type": "HowToStep",
      "text": "Sprinkle with garlic powder, salt, and seasoning."
    },
    {
      "@type": "HowToStep",
      "text": "Dip in milk, then egg mixture, then bread crumbs."
    },
    {
      "@type": "HowToStep",
      "text": "Bake in a 9x13 inch pan at 350°F until golden."
    },
    {
      "@type": "HowToStep",
      "text": "Serve with rice or noodles."
    }
  ],
