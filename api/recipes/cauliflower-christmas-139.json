{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Cauliflower Christmas",
  "author": {
    "@type": "Person",
    "name": "Kim MacDonald"
  },
  "description": "A layered cauliflower dish with Swiss cheese, green peppers, and mushrooms, baked until golden.",
  "recipeCategory": "Side Dish",
  "recipeCuisine": "American",
  "prepTime": "PT20M",
  "cookTime": "PT25M",
  "totalTime": "PT45M",
  "recipeYield": "1 baking dish",
  "recipeIngredient": [
    "2 cups milk",
    "1 large cauliflower",
    "1 cup shredded Swiss cheese",
    "1 cup diced green peppers",
    "2 Tbsp pimiento, drained",
    "1 can mushrooms, drained",
    "1 tsp salt",
    "¼ cup butter/margarine",
    "⅓ cup flour",
    "Paprika for sprinkling"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Saute the green peppers and mushrooms in butter until tender."
    },
    {
      "@type": "HowToStep",
      "text": "Add flour to the sautéed mixture and stir to combine."
    },
    {
      "@type": "HowToStep",
      "text": "Gradually stir in milk, bringing the mixture to a boil."
    },
    {
      "@type": "HowToStep",
      "text": "Remove from heat and add shredded cheese, stirring until melted."
    },
    {
      "@type": "HowToStep",
      "text": "In a greased baking dish, layer half of the cauliflower."
    },
    {
      "@type": "HowToStep",
      "text": "Top with half of the cheese sauce and half of the pimiento."
    },
    {
      "@type": "HowToStep",
      "text": "Repeat the layers, finishing with the remaining cauliflower and sauce."
    },
    {
      "@type": "HowToStep",
      "text": "Sprinkle with paprika.",
      "tool": [
        {
          "@type": "HowToTool",
          "name": "Paprika shaker"
        }
      ]
    },
    {
      "@type": "HowToStep",
      "text": "Bake uncovered at 325°F for 25 minutes.",
      "cookMethod": "Bake",
      "tool": "Oven",
      "temperature": {
        "@type": "Temperature",
        "name": "oven",
        "value": 325,
        "unitCode": "FAR"
      },
      "duration": "PT25M"
    }
  ],
  "keywords": "cauliflower, Swiss cheese, baked casserole"
}