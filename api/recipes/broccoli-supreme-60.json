{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Broccoli Supreme",
  "author": {
    "@type": "Person",
    "name": "Louise Wein"
  },
  "description": "A chilled broccoli salad with raisins, bacon, and a creamy cheese dressing.",
  "recipeCategory": "Salad",
  "recipeCuisine": "American",
  "prepTime": "PT15M",
  "cookTime": "PT10M",
  "totalTime": "PT3H25M",
  "recipeYield": "Multiple servings",
  "recipeIngredient": [
    "6 cups fresh broccoli",
    "2 Tbsp vinegar",
    "2 Tbsp vegetable oil",
    "1/3 cup raisins",
    "2 tsp white sugar",
    "2 Tbsp chopped onion",
    "1 Tbsp prepared mustard",
    "6 or 8 slices bacon, cooled and crumbled",
    "1/4 tsp salt",
    "1/8 tsp garlic powder",
    "1 small pkg cream cheese"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Beat dressing ingredients until smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Add dressing to broccoli, raisins, and onion. Cover and chill at least 3 hours."
    },
    {
      "@type": "HowToStep",
      "text": "Sprinkle with bacon and serve."
    }
  ],
  "keywords": "broccoli salad, bacon, creamy dressing",
