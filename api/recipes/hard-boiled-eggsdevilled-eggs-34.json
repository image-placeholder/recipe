  "name": "Hard Boiled Eggs/Devilled Eggs",
  "author": {
    "@type": "Person",
    "name": "Missy MacLeod"
  },
  "description": "A classic deviled egg recipe with a creamy yolk filling, garnished with paprika and optional olive slices.",
  "recipeCategory": "Appetizer",
  "recipeCuisine": "American",
  "prepTime": "PT20M",
  "cookTime": "PT15M",
  "totalTime": "PT35M",
  "recipeYield": "24 deviled eggs",
  "recipeIngredient": [
    "1 dozen (12) eggs, hard-boiled and peeled",
    "Mayonnaise",
    "Mustard (optional)",
    "Chives (optional)",
    "Pickle relish (optional)",
    "Paprika",
    "Olive slices (optional)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Place the eggs in a covered saucepan with enough cold water to cover them. Bring to a rapid boil, then turn off the heat and let stand for 15 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Cool the eggs by filling the pot with cold water and changing it frequently until the eggs are cool."
    },
    {
      "@type": "HowToStep",
      "text": "Remove the shells and rinse the eggs to remove any bits of shell."
    },
    {
      "@type": "HowToStep",
      "text": "Slice the eggs in half lengthwise and carefully scoop out the yolks into a bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Mash the yolks with a fork or pastry blender until smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Add mayonnaise and mix until the yolks reach a creamy consistency. Optionally add mustard, chives, and pickle relish to taste."
    },
    {
      "@type": "HowToStep",
      "text": "Scoop the yolk mixture back into the egg white halves."
    },
    {
      "@type": "HowToStep",
      "text": "Garnish with paprika and/or olive slices as desired."
    },
    {
      "@type": "HowToStep",
      "text": "Chill the deviled eggs until ready to serve."
    }
  ],
  "keywords": "deviled eggs, hard-boiled eggs, appetizer",
