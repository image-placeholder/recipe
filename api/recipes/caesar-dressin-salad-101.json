  "@type": "Recipe",
  "name": "Caesar Dressin' Salad",
  "author": {
    "@type": "Person",
    "name": "Linda Towton"
  },
  "description": "A homemade Caesar salad dressing made with egg yolks, garlic, lemon juice, and Parmesan cheese.",
  "recipeCategory": "Salad Dressing",
  "recipeCuisine": "American",
  "prepTime": "PT5M",
  "cookTime": "PT0M",
  "totalTime": "PT5M",
  "recipeYield": "1 batch",
  "recipeIngredient": [
    "½ tsp Worcestershire sauce",
    "3 garlic cloves",
    "½ tsp dry mustard",
    "2 beaten egg yolks",
    "½ tsp salt",
    "½ cup lemon juice",
    "Dash pepper",
    "1 cup oil",
    "¼ cup white sugar",
    "1 cup Parmesan cheese"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put all ingredients in a blender or food processor and blend for 2 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Can be kept in the fridge for up to 2 weeks."
    }
  ],
