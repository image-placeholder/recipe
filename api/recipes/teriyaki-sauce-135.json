  "recipeIngredient": [
    "1/4 cup soy sauce",
    "1 clove garlic, minced",
    "2 Tbsp honey",
    "1/4 tsp hot pepper (or to taste)",
    "1 Tbsp rice vinegar",
    "1 Tbsp minced ginger root"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
