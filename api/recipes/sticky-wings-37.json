  "recipeYield": "2-3 lbs chicken wings",
  "recipeIngredient": [
    "2-3 lbs chicken wings",
    "1 cup brown sugar",
    "¼ cup soy sauce",
    "2 tsp garlic salt"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat oven to 300°F."
    },
    {
      "@type": "HowToStep",
      "text": "Break chicken wings apart at the joints and discard tips."
    },
    {
      "@type": "HowToStep",
      "text": "Place wings in a roasting pan and cover with the sauce mixture (brown sugar, soy sauce, garlic salt)."
    },
    {
      "@type": "HowToStep",
      "text": "Bake until the sauce evaporates and wings are sticky."
    }
  ],
