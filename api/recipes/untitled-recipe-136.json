{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Zesty BBQ Sauce",
  "author": {
    "@type": "Person",
    "name": "Sharon Allen"
  },
  "description": "A tangy and spicy BBQ sauce with ketchup, vinegar, and a kick of cayenne pepper, great for grilling.",
  "recipeCategory": "Sauce",
  "recipeCuisine": "American",
  "prepTime": "PT10M",
  "cookTime": "PT10M",
  "totalTime": "PT20M",
  "recipeYield": "1 batch",
  "recipeIngredient": [
    "1 cup ketchup",
    "1 tsp dry mustard",
    "1/4 cup white vinegar",
    "1/4 tsp salt",
    "1/2 cup brown sugar",
    "1/4 tsp cayenne pepper",
    "1 Tbsp chili powder",
    "2 cloves garlic, crushed",
    "1 Tbsp Worcestershire sauce"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine all ingredients in a saucepan."
    },
    {
      "@type": "HowToStep",
      "text": "Blend and bring to a boil, stirring until sugar has dissolved."
    },
    {
      "@type": "HowToStep",
      "text": "Simmer for 10 minutes, stirring occasionally."
    },
    {
      "@type": "HowToStep",
      "text": "Refrigerate or freeze for later use."
    }
  ],
  "keywords": "BBQ sauce, zesty, spicy, grilling sauce"
}