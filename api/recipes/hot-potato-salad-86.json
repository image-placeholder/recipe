    "⅓ cup white vinegar",
    "1 Tbsp flour",
    "¾ cup water",
    "1 Tbsp butter",
    "Salt and pepper to taste",
    "Pinch of sugar"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "In a saucepan, combine the white vinegar, flour, and water. Heat, stirring constantly, until the mixture thickens."
