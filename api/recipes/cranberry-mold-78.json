  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Put the cranberries and whole orange through a food chopper."
    },
    {
      "@type": "HowToStep",
      "text": "Mix the chopped cranberries and orange with sugar and raspberry Jello powder."
    },
    {
      "@type": "HowToStep",
      "text": "Put the mixture in a mold and set."
    }
  ],
