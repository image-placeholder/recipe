{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Artichoke Appetizer",
  "author": {
    "@type": "Person",
    "name": "Loma Finkbeiner"
  },
  "description": "A warm, cheesy artichoke appetizer perfect for serving with bread or crackers.",
  "recipeCategory": "Appetizer",
  "recipeCuisine": "American",
  "prepTime": "PT10M",
  "cookTime": "PT25M",
  "totalTime": "PT35M",
  "recipeYield": "1 casserole",
  "recipeIngredient": [
    "1 (14 oz) can artichoke hearts",
    "Dash garlic salt",
    "1 cup grated Parmesan cheese",
    "2 Tbsp chopped green onion",
    "1 cup shredded mozzarella cheese",
    "1 Tbsp chopped parsley",
    "1 cup Hellmann's mayonnaise"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Drain artichoke hearts."
    },
    {
      "@type": "HowToStep",
      "text": "Combine artichoke hearts with cheese, mayonnaise, garlic salt, and green onion in a casserole dish."
    },
    {
      "@type": "HowToStep",
      "text": "Sprinkle parsley over the top."
    },
    {
      "@type": "HowToStep",
      "text": "Bake at 350°F for 25 to 30 minutes.",
      "cookMethod": "Bake",
      "tool": "Oven",
      "temperature": {
        "@type": "Temperature",
        "name": "oven",
        "value": 350,
        "unitCode": "FAR"
      },
      "duration": "PT25M"
    },
    {
      "@type": "HowToStep",
      "text": "Serve with bread or crackers."
    }
  ],
  "keywords": "artichoke appetizer, cheesy dip, party snack",
