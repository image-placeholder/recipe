  "name": "Turnip Casserole",
  "author": {
    "@type": "Person",
    "name": "Jean E. Neil"
  },
  "description": "A savory turnip casserole with apples and a crunchy bread crumb topping, perfect for freezing.",
  "recipeCategory": "Casserole",
  "recipeCuisine": "American",
  "prepTime": "PT25M",
  "cookTime": "PT45M",
  "totalTime": "PT1H10M",
  "recipeYield": "1 casserole",
  "recipeIngredient": [
    "5 cups mashed cooked turnip",
    "¼ tsp pepper",
    "1 cup chopped apples (optional)",
    "2 eggs",
    "¼ cup butter",
    "1 tsp salt",
    "1¼ cups fine bread crumbs",
    "2 Tbsp melted butter"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine the mashed turnip, pepper, chopped apples (if using), eggs, butter, and salt in a bowl. Mix well."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer the turnip mixture to a buttered ovenproof casserole dish."
    },
    {
      "@type": "HowToStep",
      "text": "Prepare the topping by mixing the bread crumbs with the melted butter until well combined."
    },
    {
      "@type": "HowToStep",
      "text": "Sprinkle the bread crumb mixture evenly over the top of the casserole."
    },
    {
      "@type": "HowToStep",
      "text": "Bake, uncovered, at 350 °F for 45 minutes or until thoroughly heated.",
      "cookMethod": "Bake",
      "tool": "Oven",
      "temperature": {
        "@type": "Temperature",
        "name": "oven",
        "value": 350,
        "unitCode": "FAR"
      },
      "duration": "PT45M"
    }
  ],
  "keywords": "turnip casserole, bread crumb topping, savory side dish, freezer-friendly",
