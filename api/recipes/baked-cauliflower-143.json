  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Baked Cauliflower",
  "author": [
    {
      "@type": "Person",
      "name": "June Schroeder"
    },
    {
      "@type": "Person",
      "name": "Marie Dinney"
    }
  ],
  "description": "A creamy baked cauliflower casserole with cheese, mayonnaise, and curry powder.",
  "recipeCategory": "Side Dish",
  "recipeCuisine": "American",
  "prepTime": "PT10M",
  "cookTime": "PT30M",
  "totalTime": "PT40M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1 large cauliflower, broken apart",
    "1 (10 oz) can cream of chicken soup",
    "1 cup shredded cheese",
    "1/3 cup mayonnaise",
    "1/2 tsp salt",
    "1/2 tsp curry powder",
    "1/4 cup bread crumbs",
    "2 Tbsp melted butter"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cook cauliflower in boiling water and salt for 10 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "In a casserole dish, stir together undiluted soup, cheese, mayonnaise, and curry powder."
    },
    {
      "@type": "HowToStep",
      "text": "Add cauliflower and mix well."
    },
    {
      "@type": "HowToStep",
      "text": "Toss bread crumbs in melted butter and sprinkle on top."
    },
    {
      "@type": "HowToStep",
      "text": "Bake for 30 minutes at 250°F until bubbly."
    }
  ],
  "keywords": "baked cauliflower, cheesy casserole",
  "_naturalized_times": {
    "prepTime": "10 minutes",
    "cookTime": "30 minutes",
    "totalTime": "40 minutes"
  }
}