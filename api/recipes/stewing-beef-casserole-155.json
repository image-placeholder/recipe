  "totalTime": "PT4H20M",
  "recipeYield": "1 casserole",
  "recipeIngredient": [
    "1 lb stewing beef",
    "1 tsp salt",
    "Dash pepper",
    "1¼ cups diced potatoes",
    "1¼ cups diced carrots",
    "1 tsp sugar",
    "2 Tbsp Minit Tapioca",
    "½ cup diced onions",
    "1 cup V8 juice",
    "½ cup diced celery"
