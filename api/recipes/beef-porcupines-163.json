{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Beef Porcupines",
  "author": {
    "@type": "Person",
    "name": "Bernice Martin"
  },
  "description": "Baked meatballs with rice, served in a tangy tomato-based sauce.",
  "recipeCategory": "Main Course",
  "recipeCuisine": "American",
  "prepTime": "PT20M",
  "cookTime": "PT1H",
  "totalTime": "PT1H20M",
  "recipeYield": "Multiple servings",
  "recipeIngredient": [
    "1 lb ground beef",
    "½ cup uncooked long-grain rice",
    "¼ cup chopped onion",
    "1 tsp prepared mustard",
    "1 tsp chili powder",
    "1 tsp salt",
    "¼ tsp allspice",
    "1 tsp brown sugar",
    "1/8 tsp pepper",
    "1 tsp Worcestershire sauce",
    "1 tsp paprika",
    "1 (10 oz) can tomato soup",
    "1 soup can hot water"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix ground beef, rice, onion, mustard, chili powder, salt, allspice, brown sugar, pepper, Worcestershire sauce, and paprika. Form into balls."
    },
    {
      "@type": "HowToStep",
      "text": "Place meatballs in a baking dish."
    },
    {
      "@type": "HowToStep",
      "text": "Combine tomato soup and hot water to make the sauce. Pour over meatballs."
    },
    {
      "@type": "HowToStep",
      "text": "Cover and bake at 350°F for 1 hour."
    }
  ],
  "keywords": "beef porcupines, baked meatballs, rice",
