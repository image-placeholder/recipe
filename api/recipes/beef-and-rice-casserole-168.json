  "name": "Beef and Rice Casserole",
  "author": {
    "@type": "Person",
    "name": "Kurtis Brand"
  },
  "description": "A hearty casserole featuring ground beef, sautéed celery and onion, and cooked rice, all baked in a tomato soup sauce.",
  "recipeCategory": "Casserole",
  "recipeCuisine": "American",
  "prepTime": "PT20M",
  "cookTime": "PT30M",
  "totalTime": "PT50M",
  "recipeYield": "1 1½ quart casserole",
  "recipeIngredient": [
    "1⅓ cups cooked rice",
    "1 tsp salt",
    "1 Tbsp butter",
    "Dash pepper",
    "1½ cups diced celery",
    "3 Tbsp minced onion",
    "1 can condensed tomato soup",
    "¼ cup water",
    "1 lb ground beef"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Sauté celery and onion in butter until soft and tender."
    },
    {
      "@type": "HowToStep",
      "text": "Place rice in a greased 1½ quart casserole dish."
    },
    {
      "@type": "HowToStep",
      "text": "Top the rice with the celery mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Season the ground beef with salt and pepper, then cook in a skillet until browned."
    },
    {
      "@type": "HowToStep",
      "text": "Arrange the cooked beef on top of the celery mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Combine the tomato soup with water and pour over the meat layer."
    },
    {
      "@type": "HowToStep",
      "text": "Bake in a preheated 325°F oven for ½ hour.",
      "cookMethod": "Bake",
      "tool": "Oven",
      "temperature": {
        "@type": "Temperature",
        "name": "oven",
        "value": 325,
        "unitCode": "FAR"
      },
      "duration": "PT30M"
    }
  ],
