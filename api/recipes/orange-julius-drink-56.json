  "prepTime": "PT5M",
  "cookTime": "PT0M",
  "totalTime": "PT5M",
  "recipeYield": "About 5 cups",
  "recipeIngredient": [
    "3/4 cup frozen concentrated orange juice",
    "2 Tbsp white sugar",
    "2 tsp vanilla",
    "1 cup milk",
    "1 cup water",
    "12 ice cubes"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Blend the orange juice concentrate, sugar, vanilla, milk, and water in a blender until smooth."
    },
    {
      "@type": "HowToStep",
      "text": "Add ice cubes just before serving and blend until the ice is fully incorporated."
    },
    {
      "@type": "HowToStep",
      "text": "Serve immediately and enjoy."
    }
  ],
