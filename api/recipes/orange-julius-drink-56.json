    "2 Tbsp white sugar",
    "2 tsp vanilla",
    "1 cup milk",
    "1 cup water",
    "12 ice cubes"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Blend the orange juice concentrate, sugar, vanilla, milk, and water in a blender until smooth."
    },
    {
