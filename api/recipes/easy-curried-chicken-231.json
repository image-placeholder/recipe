  "recipeIngredient": [
    "Chicken pieces",
    "2 cans cream of chicken soup",
    "¾ cup mayonnaise",
    "1 tsp curry powder (or to taste)",
    "Broccoli and carrots, cut into bite-size pieces",
    "Bread crumbs for topping"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Grease the bottom of a pan and layer with vegetables."
    },
    {
      "@type": "HowToStep",
      "text": "Arrange chicken pieces on top of the vegetables."
    },
    {
      "@type": "HowToStep",
      "text": "Mix cream of chicken soup, mayonnaise, and curry powder."
    },
    {
      "@type": "HowToStep",
      "text": "Pour the soup mixture over the chicken."
    },
    {
      "@type": "HowToStep",
      "text": "Sprinkle bread crumbs on top."
    },
    {
      "@type": "HowToStep",
      "text": "Bake at 375°F for 1 hour."
    }
  ],
