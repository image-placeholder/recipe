  "author": {
    "@type": "Person",
    "name": "Ruth Haines"
  },
  "description": "A colorful salad of marinated vegetables including cauliflower, broccoli, carrots, and radishes, dressed with Italian dressing.",
  "recipeCategory": "Salad",
  "recipeCuisine": "American",
  "prepTime": "PT30M",
  "cookTime": "PT0M",
  "totalTime": "PT30M",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "1 medium cauliflower",
    "1 bunch broccoli",
    "3 celery stalks",
    "1/2 English cucumber",
    "1/2 bunch radishes",
    "Baby carrots",
    "Cherry tomatoes",
    "1 bottle Italian dressing"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Wash and clean all the vegetables, then drain well."
    },
    {
      "@type": "HowToStep",
      "text": "Break cauliflower and broccoli into bite-sized pieces."
    },
    {
      "@type": "HowToStep",
      "text": "Trim radishes and carrots; leave whole or cut into bite-sized pieces if large."
    },
    {
      "@type": "HowToStep",
      "text": "Cut celery into 3-inch pieces and slice cucumber into 1/2-inch slices."
    },
    {
      "@type": "HowToStep",
      "text": "Leave cherry tomatoes whole and place all vegetables in a large bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Pour Italian dressing over the vegetables and let set for a few hours."
    },
    {
      "@type": "HowToStep",
      "text": "Serve as finger food or as a salad."
    }
  ],
  "keywords": "marinated vegetables, vegetable salad, Italian dressing",
