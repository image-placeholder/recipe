    },
    {
      "@type": "HowToStep",
      "text": "Combine the softened cream cheese with the salmon and all remaining ingredients."
    },
    {
      "@type": "HowToStep",
      "text": "Mix well and serve with crackers or as a spread."
    }
  ],
