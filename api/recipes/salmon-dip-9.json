  "prepTime": "PT5M",
  "cookTime": "PT0M",
  "totalTime": "PT5M",
  "recipeIngredient": [
    "1 (8 oz) package cream cheese, softened",
    "1 can red salmon",
    "1 tsp garlic powder or 1 fresh garlic clove, minced",
    "2 tsp lemon juice",
    "2 Tbsp onion, minced",
    "1 Tbsp fresh or dry parsley"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Drain the salmon and remove any bones."
    },
    {
      "@type": "HowToStep",
