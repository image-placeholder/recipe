{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Rumaki",
  "author": {
    "@type": "Person",
    "name": "Leanne Robinson"
  },
  "description": "Classic rumaki appetizer featuring bacon-wrapped water chestnuts baked in a ketchup and brown sugar glaze.",
  "recipeCategory": "Appetizer",
  "recipeCuisine": "American",
  "prepTime": "PT10M",
  "cookTime": "PT1H",
  "totalTime": "PT1H10M",
  "recipeYield": "1 batch",
  "recipeIngredient": [
    "1 lb bacon",
    "1 can water chestnuts",
    "½ cup ketchup",
    "½ cup brown sugar"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Cut the pound of bacon in half."
    },
    {
      "@type": "HowToStep",
      "text": "Wrap bacon around chestnuts and secure with toothpicks."
    },
    {
      "@type": "HowToStep",
      "text": "Bake at 350°F for ½ hour.",
      "cookMethod": "Bake",
      "tool": "Oven",
      "temperature": {
        "@type": "Temperature",
        "name": "oven",
        "value": 350,
        "unitCode": "FAR"
      },
      "duration": "PT30M"
    },
    {
      "@type": "HowToStep",
      "text": "Drain grease."
    },
    {
      "@type": "HowToStep",
      "text": "Mix ketchup and brown sugar."
    },
    {
      "@type": "HowToStep",
      "text": "Pour mixture over chestnuts and bake for another ½ hour.",
      "cookMethod": "Bake",
      "tool": "Oven",
      "duration": "PT30M"
    }
  ],
  "keywords": "rumaki, bacon-wrapped water chestnuts, appetizer"
}