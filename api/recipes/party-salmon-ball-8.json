    "¼ tsp Liquid Smoke",
    "¼ tsp salt",
    "1 Tbsp finely chopped onion",
    "⅓ cup nuts",
    "¼ cup parsley flakes"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix all ingredients together except for the nuts and parsley."
