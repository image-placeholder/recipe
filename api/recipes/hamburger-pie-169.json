{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Hamburger Pie",
  "author": {
    "@type": "Person",
    "name": "Marguerite Finkbeiner"
  },
  "description": "A savory pie made with ground beef, green beans, and tomato soup, topped with a layer of mashed potatoes and baked until golden.",
  "recipeCategory": "Casserole",
  "recipeCuisine": "American",
  "prepTime": "PT25M",
  "cookTime": "PT30M",
  "totalTime": "PT55M",
  "recipeYield": "1 casserole",
  "recipeIngredient": [
    "1 medium onion, sliced",
    "1 to 1½ cups cooked green beans",
    "1 Tbsp oil",
    "1 lb hamburger",
    "¼ tsp salt",
    "⅛ tsp pepper",
    "1 can tomato soup",
    "5 medium potatoes",
    "½ cup warm milk",
    "1 beaten egg"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat 4 Tbsp oil in a pan and brown the sliced onion."
    },
    {
      "@type": "HowToStep",
      "text": "Add the hamburger, salt, and pepper to the pan and brown the meat."
    },
    {
      "@type": "HowToStep",
      "text": "Add the cooked green beans and tomato soup to the meat mixture and mix well."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer the mixture to a casserole dish."
    },
    {
      "@type": "HowToStep",
      "text": "Boil the potatoes until tender, then mash with warm milk and beaten egg."
    },
    {
      "@type": "HowToStep",
      "text": "Spoon the mashed potatoes in mounds over the top of the meat mixture in the casserole."
    },
    {
      "@type": "HowToStep",
      "text": "Bake at 350°F for 30 minutes.",
      "cookMethod": "Bake",
      "tool": "Oven",
      "temperature": {
        "@type": "Temperature",
        "name": "oven",
        "value": 350,
        "unitCode": "FAR"
      },
      "duration": "PT30M"
    }
  ],
  "keywords": "hamburger pie, shepherd's pie, casserole",
  "_naturalized_times": {
    "prepTime": "25 minutes",
    "cookTime": "30 minutes",
    "totalTime": "55 minutes"
  }
}