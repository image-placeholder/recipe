{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Salad Dressing",
  "author": {
    "@type": "Person",
    "name": "Evelyn Pickering"
  },
  "description": "A thickened salad dressing made by boiling a mixture of eggs, sugar, flour, mustard, water, and vinegar, finished with butter.",
  "recipeCategory": "Salad Dressing",
  "recipeCuisine": "American",
  "prepTime": "PT10M",
  "cookTime": "PT10M",
  "totalTime": "PT20M",
  "recipeYield": "1 batch",
  "recipeIngredient": [
    "3 Tbsp flour",
    "3 eggs",
    "1 cup white sugar",
    "1½ cups water",
    "1 Tbsp dry mustard",
    "1 cup vinegar",
    "1 Tbsp butter"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Beat eggs and add sugar and dry ingredients."
    },
    {
      "@type": "HowToStep",
      "text": "Boil water and vinegar together."
    },
    {
      "@type": "HowToStep",
      "text": "Pour egg mixture into vinegar-water mixture and boil until it thickens, stirring continually."
    },
    {
      "@type": "HowToStep",
      "text": "Take off heat and stir in 1 Tbsp butter."
    }
  ],
  "keywords": "thickened salad dressing, boiled dressing",
