  "prepTime": "PT30M",
  "cookTime": "PT2H",
  "totalTime": "PT2H30M",
  "recipeYield": "22 cups",
  "recipeIngredient": [
    "6 cups water",
    "6 beef bouillon cubes",
    "1 Tbsp parsley flakes",
    "28 oz canned tomato",
    "1 tsp sugar",
    "10 oz condensed tomato soup",
    "1 tsp salt",
    "2 cups shredded carrots",
    "¼ tsp pepper",
    "2 cups shredded potatoes",
    "¾ tsp thyme",
    "1½ cups chopped onion",
    "3 cups cooked roast beef (or 2-3 cups chopped hamburg meat)",
    "1 cup chopped celery",
    "½ cup pearl or pot barley"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Heat water and bouillon cubes in a large pot, stirring until dissolved."
    },
    {
      "@type": "HowToStep",
      "text": "Add remaining ingredients except beef and bring to a boil."
    },
    {
      "@type": "HowToStep",
      "text": "Simmer for 1½ hours."
    },
    {
      "@type": "HowToStep",
      "text": "Add beef and simmer for an additional ½ hour."
    }
  ],
