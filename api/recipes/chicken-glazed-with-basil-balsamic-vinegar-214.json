  "name": "Chicken Glazed with Basil & Balsamic Vinegar",
  "author": {
    "@type": "Person",
    "name": "Karen Janzen"
  },
  "description": "A glazed chicken breast recipe with basil, balsamic vinegar, and honey.",
  "recipeCategory": "Main Course",
  "recipeCuisine": "American",
  "prepTime": "PT15M",
  "cookTime": "PT20-30M",
  "totalTime": "PT35-45M",
  "recipeYield": "6-8 servings",
  "recipeIngredient": [
    "6-8 boneless, skinned chicken breasts",
    "2 Tbsp fresh chopped basil",
    "4 cloves garlic, minced",
    "1/4 cup butter",
    "1/3 cup honey",
    "1/4 cup Dijon mustard",
    "2 Tbsp balsamic vinegar",
    "Salt and pepper to taste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat oven to 350°F."
    },
    {
      "@type": "HowToStep",
      "text": "Place chicken breasts in a shallow baking dish."
    },
    {
      "@type": "HowToStep",
      "text": "In a saucepan, bring remaining ingredients to a boil."
    },
    {
      "@type": "HowToStep",
      "text": "Remove from heat and pour over chicken."
    },
    {
      "@type": "HowToStep",
      "text": "Bake for 20-30 minutes or until chicken is cooked, basting occasionally with the glaze."
    },
    {
      "@type": "HowToStep",
      "text": "Serve warm or cold."
    }
  ],
  "keywords": "glazed chicken, basil, balsamic vinegar",
