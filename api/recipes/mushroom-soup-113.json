{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Mushroom Soup",
  "author": {
    "@type": "Person",
    "name": "Valerie (Finkbeiner) Mullin"
  },
  "description": "A creamy mushroom soup made with sautéed mushrooms, onions, and garlic in a rich milk-based broth.",
  "recipeCategory": "Soup",
  "recipeCuisine": "American",
  "prepTime": "PT10M",
  "cookTime": "PT15M",
  "totalTime": "PT25M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "3 Tbsp butter",
    "1 onion, chopped",
    "3 cloves garlic, minced",
    "2 cups sliced mushrooms",
    "1/4 cup flour",
    "2 cups stock (chicken or vegetable)",
    "1 Tbsp soya sauce",
    "1 tsp Worcestershire sauce",
    "3 cups milk"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Saute butter, onion, garlic and mushrooms."
    },
    {
      "@type": "HowToStep",
      "text": "Add flour and stir together."
    },
    {
      "@type": "HowToStep",
      "text": "Add stock, sauces and milk."
    },
    {
      "@type": "HowToStep",
      "text": "Simmer until heated through (approximately 15 minutes)."
    },
    {
      "@type": "HowToStep",
      "text": "Serve hot."
    }
  ],
  "keywords": "mushroom soup, creamy soup, comfort food",
  "_naturalized_times": {
    "prepTime": "10 minutes",
    "cookTime": "15 minutes",
    "totalTime": "25 minutes"
  }
}