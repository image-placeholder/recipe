      },
      "description": "A flavorful and aromatic Asian-inspired soup featuring pork, ginger, and rice stick noodles in a savory chicken broth.",
      "recipeCategory": "Soup",
      "recipeCuisine": "Asian",
      "prepTime": "PT15M",
      "cookTime": "PT10M",
      "totalTime": "PT25M",
      "recipeYield": "4 servings",
      "recipeIngredient": [
        "1 pork chop, sliced into small pieces",
        "1 onion, chopped",
        "3 cloves garlic, minced",
        "2 Tbsp chopped ginger root",
        "2 Tbsp soy sauce",
        "4 cups chicken stock",
        "1/3 cup hoisin sauce",
        "1 carrot, shredded",
        "1/2 cup sliced mushrooms",
        "1 cup rice stick noodles",
        "1 green onion, thinly sliced",
        "1/2 cup bean sprouts",
        "4 sprigs coriander (cilantro)"
      ],
      "recipeInstructions": [
        {
          "@type": "HowToStep",
          "text": "In a saucepan brown pork over medium heat."
        },
        {
          "@type": "HowToStep",
          "text": "Add onion, garlic, ginger, hoisin sauce and soy sauce. Cook for 2 minutes."
        },
        {
          "@type": "HowToStep",
          "text": "Add rest of ingredients, bring to a boil, reduce heat and simmer 10 minutes."
        },
        {
          "@type": "HowToStep",
          "text": "Garnish with green onion and coriander."
        }
      ],
