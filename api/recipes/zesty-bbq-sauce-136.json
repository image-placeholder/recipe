    "1 tsp dry mustard",
    "1/4 cup white vinegar",
    "1/4 tsp salt",
    "1/2 cup brown sugar",
    "1/4 tsp cayenne pepper",
    "1 Tbsp chili powder",
    "2 cloves garlic, crushed",
    "1 Tbsp Worcestershire sauce"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine all ingredients in a saucepan."
    },
