{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Boneless Chicken Breasts",
  "author": {
    "@type": "Person",
    "name": "Laura Nakamura"
  },
  "description": "A stuffed boneless chicken breast recipe with ham, cheese, and onions.",
  "recipeCategory": "Main Course",
  "recipeCuisine": "American",
  "prepTime": "PT20M",
  "cookTime": "PT30M",
  "totalTime": "PT50M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "4 boneless chicken breasts",
    "1 cup fine bread crumbs",
    "1 beaten egg",
    "1 Tbsp milk",
    "Ham, cut in strips",
    "Cheese, shredded",
    "Onions, finely chopped",
    "Salt and pepper to taste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Pound chicken with a frying pan or mallet, skin side down."
    },
    {
      "@type": "HowToStep",
      "text": "Layer with ham, cheese, and onions."
    },
    {
      "@type": "HowToStep",
      "text": "Roll up and dip in egg mixture, then coat with bread crumbs."
    },
    {
      "@type": "HowToStep",
      "text": "Put in a cake or casserole pan and bake at 350°F for 1/2 hour or until chicken is cooked."
    }
  ],
  "keywords": "stuffed chicken breast, boneless chicken",
  "_naturalized_times": {
    "prepTime": "20 minutes",
    "cookTime": "30 minutes",
    "totalTime": "50 minutes"
  }
}