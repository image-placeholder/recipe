    "Cheese, shredded",
    "Onions, finely chopped",
    "Salt and pepper to taste"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Pound chicken with a frying pan or mallet, skin side down."
    },
    {
      "@type": "HowToStep",
      "text": "Layer with ham, cheese, and onions."
    },
    {
      "@type": "HowToStep",
      "text": "Roll up and dip in egg mixture, then coat with bread crumbs."
    },
    {
      "@type": "HowToStep",
      "text": "Put in a cake or casserole pan and bake at 350°F for 1/2 hour or until chicken is cooked."
    }
  ],
