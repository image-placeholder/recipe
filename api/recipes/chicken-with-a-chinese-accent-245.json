{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Chicken with a Chinese Accent",
  "author": {
    "@type": "Person",
    "name": "Suzanne Finkbeiner"
  },
  "description": "A sweet and savory chicken dish with a Chinese-inspired flavor profile, featuring soya sauce and brown sugar.",
  "recipeCategory": "Main Course",
  "recipeCuisine": "Chinese-American",
  "prepTime": "PT15M",
  "cookTime": "PT35M",
  "totalTime": "PT50M",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "6 boneless, skinless chicken breasts",
    "1 can cream of mushroom soup",
    "15 mL oil",
    "50 mL vinegar",
    "50 mL soya sauce",
    "125 mL brown sugar",
    "1 finely chopped onion"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Fry chicken breasts in a frying pan with oil and soya sauce until the outsides are done."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer the chicken to a casserole dish."
    },
    {
      "@type": "HowToStep",
      "text": "Mix the remaining ingredients with soya sauce and pour over the chicken."
    },
    {
      "@type": "HowToStep",
      "text": "Bake for 35 minutes at 350°F.",
      "cookMethod": "Bake",
      "tool": "Oven",
      "temperature": {
        "@type": "Temperature",
        "name": "oven",
        "value": 350,
        "unitCode": "FAR"
      },
      "duration": "PT35M"
    },
    {
      "@type": "HowToStep",
      "text": "Serve the chicken with rice."
    }
  ],
  "keywords": "Chinese chicken, sweet and savory, baked chicken"
}