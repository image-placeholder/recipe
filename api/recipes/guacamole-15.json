  "description": "A fresh and simple guacamole recipe made with chilled avocado, lime juice, and minced Spanish onion.",
  "recipeCategory": "Appetizer",
  "recipeCuisine": "Mexican",
  "prepTime": "PT5M",
  "cookTime": "PT0M",
  "totalTime": "PT5M",
  "recipeIngredient": [
    "1 avocado, chilled",
    "1 tsp lime juice",
    "2 tsp finely minced Spanish onion"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mash the chilled avocado in a bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in lime juice and minced Spanish onion until well combined."
    },
    {
      "@type": "HowToStep",
      "text": "Serve immediately with tortilla chips."
    }
  ],
  "keywords": "guacamole, avocado dip, Mexican appetizer",
