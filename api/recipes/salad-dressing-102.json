{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Salad Dressing",
  "author": {
    "@type": "Person",
    "name": "Marie Dinney"
  },
  "description": "A cooked salad dressing made with eggs, sugar, mustard, and vinegar, thickened with cornstarch.",
  "recipeCategory": "Salad Dressing",
  "recipeCuisine": "American",
  "prepTime": "PT5M",
  "cookTime": "PT8M",
  "totalTime": "PT13M",
  "recipeYield": "1 batch",
  "recipeIngredient": [
    "1 tsp salt",
    "2 eggs",
    "1 cup white sugar",
    "2 tsp dry mustard",
    "1 cup vinegar",
    "3 Tbsp cornstarch",
    "1 cup 2% milk"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix all ingredients thoroughly."
    },
    {
      "@type": "HowToStep",
      "text": "Cook in the microwave for approximately 8 minutes."
    }
  ],
  "keywords": "cooked salad dressing, creamy dressing"
}