{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Curry Chicken",
  "author": {
    "@type": "Person",
    "name": "Leslie Jenni"
  },
  "recipeCategory": "Main Course",
  "recipeCuisine": "International",
  "prepTime": "PT10M",
  "cookTime": "PT1H",
  "totalTime": "PT1H10M",
  "recipeYield": "4-6 servings",
  "recipeIngredient": [
    "6 to 8 boneless chicken breasts",
    "¼ cup Dijon mustard",
    "2 Tbsp prepared mustard",
    "1 Tbsp lime juice",
    "¼ cup butter",
    "1 tsp curry powder",
    "½ cup honey"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Preheat oven to 350°F."
    },
    {
      "@type": "HowToStep",
      "text": "Mix all ingredients except chicken breasts in a microwave-safe bowl until butter is melted."
    },
    {
      "@type": "HowToStep",
      "text": "Arrange chicken breasts in a shallow baking dish sprayed with nonstick spray."
    },
    {
      "@type": "HowToStep",
      "text": "Pour the curry mixture over the chicken breasts."
    },
    {
      "@type": "HowToStep",
      "text": "Bake uncovered for 1 hour, stirring occasionally."
    },
    {
      "@type": "HowToStep",
      "text": "Serve over rice."
    }
  ],
  "keywords": "curry chicken, baked chicken, honey mustard chicken"
}