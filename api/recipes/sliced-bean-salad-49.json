  "name": "Sliced Bean Salad",
  "author": {
    "@type": "Person",
    "name": "Phyllis Lightfoot"
  },
  "description": "A tangy and sweet pickled bean salad made with green or yellow beans, perfect for serving with onion and cream.",
  "recipeCategory": "Salad",
  "recipeCuisine": "American",
  "prepTime": "PT20M",
  "cookTime": "PT10M",
  "totalTime": "PT30M",
  "recipeYield": "2 to 3 quarts",
  "recipeIngredient": [
    "Yellow or green beans",
    "2 cups white vinegar",
    "2 cups white sugar",
    "1 tsp salt",
    "1½ cups water",
    "Onion and cream for serving"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Slice the beans and cook until tender enough to pierce with a fork."
    },
    {
      "@type": "HowToStep",
      "text": "Drain the cooked beans and pack them into jars."
    },
    {
      "@type": "HowToStep",
      "text": "In a saucepan, bring the sugar, water, vinegar, and salt to a boil to make the syrup."
    },
    {
      "@type": "HowToStep",
      "text": "Pour the hot syrup over the beans in the jars."
    },
    {
      "@type": "HowToStep",
      "text": "To serve, pour off the liquid and add chopped onion and cream."
    }
  ],
  "keywords": "pickled bean salad, sweet and tangy, preserved beans",
  "_naturalized_times": {
    "prepTime": "20 minutes",
    "cookTime": "10 minutes",
    "totalTime": "30 minutes"
  },
