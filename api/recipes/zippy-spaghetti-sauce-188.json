{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Zippy Spaghetti Sauce",
  "author": {
    "@type": "Person",
    "name": "Kate Cunningham"
  },
  "description": "A flavorful and spicy spaghetti sauce with sausage, hamburger, and taco seasoning.",
  "recipeCategory": "Main Course",
  "recipeCuisine": "Italian-American",
  "prepTime": "PT20M",
  "cookTime": "PT30M",
  "totalTime": "PT50M",
  "recipeYield": "Several servings",
  "recipeIngredient": [
    "1 lb lean ground hamburger",
    "2 jumbo summer sausage slices",
    "1/2 onion, chopped",
    "1 tsp garlic",
    "1 tsp oregano flakes",
    "1 tsp salt",
    "1/4 tsp pepper",
    "1 envelope regular taco seasoning (El Paso)",
    "1 jar Ragu spaghetti sauce (700 mL)",
    "1 can sliced mushrooms, drained"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Brown the hamburger and chopped onion."
    },
    {
      "@type": "HowToStep",
      "text": "Add garlic, oregano, salt, pepper, and taco seasoning."
    },
    {
      "@type": "HowToStep",
      "text": "Chop the summer sausage into 1/4 inch pieces and add to the mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Add the Ragu spaghetti sauce and drained mushrooms."
    },
    {
      "@type": "HowToStep",
      "text": "Simmer for 10 minutes."
    }
  ],
  "keywords": "spaghetti sauce, zippy sauce, sausage, taco seasoning",
