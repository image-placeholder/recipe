{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Salad Dressing",
  "author": {
    "@type": "Person",
    "name": "Doris Ohmayer"
  },
  "description": "A creamy salad dressing cooked over boiling water, made with eggs, sugar, mustard, and vinegar.",
  "recipeCategory": "Salad Dressing",
  "recipeCuisine": "American",
  "prepTime": "PT10M",
  "cookTime": "PT10M",
  "totalTime": "PT20M",
  "recipeYield": "1 batch",
  "recipeIngredient": [
    "2 well-beaten eggs",
    "2 tsp flour",
    "½ cup white sugar",
    "¾ cup white vinegar",
    "1 heaping tsp dry mustard",
    "¼ cup boiling water",
    "Pinch of salt"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix eggs, sugar, mustard, and salt together with flour."
    },
    {
      "@type": "HowToStep",
      "text": "Add vinegar and boiling water to the egg mixture."
    },
    {
      "@type": "HowToStep",
      "text": "Cook over boiling water until creamy."
    }
  ],
  "keywords": "creamy salad dressing, cooked dressing"
}