  "prepTime": "PT20M",
  "cookTime": "PT2H30M",
  "totalTime": "PT2H50M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "1/4 cup butter",
    "2 large Spanish onions",
    "1 can consomme",
    "1 can water",
    "4 Oxo cubes dissolved in 2 cups hot water",
    "Salt to flavour",
    "4 slices French bread",
    "1 cup shredded mozzarella cheese"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Melt butter. Saute onions until transparent."
    },
    {
      "@type": "HowToStep",
      "text": "Add to Oxo, consomme and water. Simmer about 2 hours."
    },
    {
      "@type": "HowToStep",
      "text": "Put in onion soup bowls, add a slice of French bread on top of each one and add shredded mozzarella cheese sprinkled over each."
    },
    {
      "@type": "HowToStep",
      "text": "Put in oven at 350°F for 30 minutes.",
