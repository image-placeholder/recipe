{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Perfect Punch",
  "author": {
    "@type": "Person",
    "name": "Julie-Ann Bibby"
  },
  "description": "A fruity and bubbly punch made with orange juice, lemonade, and raspberry sherbet.",
  "recipeCategory": "Beverage",
  "recipeCuisine": "American",
  "prepTime": "PT5M",
  "cookTime": "PT0M",
  "totalTime": "PT5M",
  "recipeYield": "Serves 14 people",
  "recipeIngredient": [
    "3 L lemon-lime carbonated beverage",
    "1 can frozen orange juice concentrate",
    "1 can frozen lemonade concentrate",
    "1 qt raspberry sherbet"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Combine the liquid drinks in a punch bowl."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in the raspberry sherbet."
    },
    {
      "@type": "HowToStep",
      "text": "Serve chilled and enjoy."
    }
  ],
