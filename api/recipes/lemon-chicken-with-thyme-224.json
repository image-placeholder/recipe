{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Lemon Chicken With Thyme",
  "author": {
    "@type": "Person",
    "name": "Karen Schwartzentruber"
  },
  "description": "A flavorful chicken dish made with lemon juice, thyme, and a light flour coating, served with lemon wedges and parsley.",
  "recipeCategory": "Main Course",
  "recipeCuisine": "American",
  "prepTime": "PT10M",
  "cookTime": "PT15M",
  "totalTime": "PT25M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "3 Tbsp flour",
    "1 Tbsp margarine",
    "1 cup chicken broth",
    "1/2 tsp salt",
    "1/4 tsp pepper",
    "3 Tbsp lemon juice",
    "1/2 tsp thyme",
    "4 boneless skinless chicken breasts",
    "2 Tbsp olive oil",
    "1 medium onion (optional)",
    "Lemon halves and chopped parsley for garnish (optional)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "In a plastic bag, combine flour, salt, and pepper. Add chicken and shake to coat lightly."
    },
    {
      "@type": "HowToStep",
      "text": "In a large skillet, warm oil over medium heat. Brown chicken about 5 minutes each side. Transfer to a plate."
    },
    {
      "@type": "HowToStep",
      "text": "Coarsely chop the onion. Add margarine to the skillet and stir until softened, 2 to 3 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Stir in reserved flour and combine. Add chicken broth, lemon juice, and thyme. Bring to a boil, stirring constantly."
    },
    {
      "@type": "HowToStep",
      "text": "Return chicken to skillet, reduce heat to medium-low, and cover. Cook until chicken is tender, about 5 minutes."
    },
    {
      "@type": "HowToStep",
      "text": "Serve with lemon wedges and a sprinkling of parsley, if desired."
    }
  ],
  "keywords": "lemon chicken, thyme, chicken breast",
