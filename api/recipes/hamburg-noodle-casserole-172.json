  "name": "Hamburg Noodle Casserole",
  "author": {
    "@type": "Person",
    "name": "Grace Yearley"
  },
  "description": "A hearty casserole made with ground beef, noodles, and a blend of creamy soups and cheese.",
  "recipeCategory": "Casserole",
  "recipeCuisine": "American",
  "prepTime": "PT20M",
  "cookTime": "PT30M",
  "totalTime": "PT50M",
  "recipeYield": "Multiple servings",
  "recipeIngredient": [
    "2 lb ground beef",
    "1 can cream of mushroom soup",
    "1 medium onion",
    "2 cans sliced mushrooms, drained",
    "1 jar Ragu (700 mL)",
    "1 pkg cooked elbow macaroni",
    "1 can cream of celery soup",
    "1 can cream of chicken soup",
    "1 cup shredded mozzarella cheese"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Brown the ground beef and onion, then add the mushrooms."
    },
    {
      "@type": "HowToStep",
      "text": "In a large bowl, combine the cooked ground beef mixture, soups, noodles, and Ragu. Mix well."
    },
    {
      "@type": "HowToStep",
      "text": "Transfer the mixture to casserole dishes and top with mozzarella cheese."
    },
    {
      "@type": "HowToStep",
      "text": "Bake until the cheese is melted."
    }
  ],
