  },
  "description": "A layered coleslaw salad with shredded carrots, snow peas, and a creamy Miracle Whip dressing.",
  "recipeCategory": "Salad",
  "recipeCuisine": "American",
  "prepTime": "PT20M",
  "cookTime": "PT0M",
  "totalTime": "PT8H20M",
  "recipeYield": "Multiple servings",
  "recipeIngredient": [
    "1/2 head cabbage, shredded",
    "1 pkg (8.5 oz) Oriental flavor dry noodles",
    "4 handfuls snow peas",
    "1 bunch chopped green onions",
    "1 sliced red pepper",
    "5 shredded carrots",
    "1 cup Miracle Whip dressing",
    "1 cup sour cream"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Shred cabbage and place in bottom of large glass bowl. Top with remaining ingredients in order given."
    },
    {
      "@type": "HowToStep",
      "text": "Combine Miracle Whip, sour cream, and package of noodle seasoning. Spread evenly over salad."
    },
    {
      "@type": "HowToStep",
      "text": "Cover and let stand overnight."
    }
  ],
