{
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": "Stuffed Mushrooms",
  "author": {
    "@type": "Person",
    "name": "Suzanne Finkbeiner"
  },
  "description": "A savory appetizer of mushroom caps filled with a creamy mixture of bacon, cream cheese, and Parmesan.",
  "recipeCategory": "Appetizer",
  "recipeCuisine": "American",
  "prepTime": "PT15M",
  "cookTime": "PT30M",
  "totalTime": "PT45M",
  "recipeYield": "15 to 20 stuffed mushrooms",
  "recipeIngredient": [
    "15 to 20 large mushrooms, stems removed",
    "3 slices bacon, cooked and crumbled",
    "¼ pkg cream cheese",
    "¼ cup Parmesan cheese",
    "1 tsp Worcestershire sauce"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Mix the crumbled bacon, cream cheese, Parmesan cheese, and Worcestershire sauce together."
    },
    {
      "@type": "HowToStep",
      "text": "Stuff the mixture into the mushroom caps."
    },
    {
      "@type": "HowToStep",
      "text": "Bake at 350°F for 30 minutes."
    }
  ],
  "keywords": "stuffed mushrooms, appetizer, bacon, cream cheese",
