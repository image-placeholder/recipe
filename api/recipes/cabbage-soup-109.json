  "name": "Cabbage Soup",
  "author": {
    "@type": "Person",
    "name": "Betty Glanville"
  },
  "description": "A hearty cabbage soup with vegetables and optional sweetener.",
  "recipeCategory": "Soup",
  "recipeCuisine": "American",
  "prepTime": "PT15M",
  "cookTime": "PT1H30M",
  "totalTime": "PT1H45M",
  "recipeYield": "6 servings",
  "recipeIngredient": [
    "½ head cabbage",
    "1 can French-style beans, drained",
    "3 cups tomato juice",
    "1 large can mushrooms",
    "4 cups water",
    "Salt, garlic pepper to taste",
    "6 stalks celery leaves and tips",
    "1 tsp lemon juice",
    "1 Tbsp liquid sweetener (optional)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Add all ingredients to a large pot."
    },
    {
      "@type": "HowToStep",
      "text": "Cook at low heat for 1½ hours."
    }
  ],
