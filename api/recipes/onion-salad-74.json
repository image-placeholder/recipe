  "description": "A simple onion salad marinated in a sweet and tangy dressing.",
  "recipeCategory": "Salad",
  "recipeCuisine": "American",
  "prepTime": "PT10M",
  "cookTime": "PT0M",
  "totalTime": "PT8H10M",
  "recipeYield": "4 servings",
  "recipeIngredient": [
    "2 Spanish onions, thinly sliced",
    "1 1/2 tsp salt",
    "1/2 cup white sugar",
    "1 cup mayonnaise or salad dressing",
    "1/3 cup water",
    "1/3 cup vinegar",
    "1 tsp celery seed"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "text": "Marinate the thinly sliced onions with salt, sugar, water, and vinegar overnight."
    },
    {
      "@type": "HowToStep",
      "text": "Drain the marinade well in the morning."
    },
    {
      "@type": "HowToStep",
      "text": "Add mayonnaise (or salad dressing) and celery seed to the drained onions."
    },
    {
      "@type": "HowToStep",
      "text": "Chill until ready to serve."
    }
  ],
  "keywords": "onion salad, marinated onions, sweet and tangy salad"
}